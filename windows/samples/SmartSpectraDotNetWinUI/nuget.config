<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore the SmartSpectra.Net package from the published Presage feed.
    `nuget.org` is required for the Windows App SDK and build-tools packages.
    `<clear />` makes the restore self-contained and reproducible regardless of
    machine-wide NuGet sources.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Stable releases of SmartSpectra.Net. -->
    <add key="SmartSpectra" value="https://packages.presagetech.com/nuget/index.json" />
    <!-- Pre-releases (release candidates). Pin an -rc version in the .csproj to use. -->
    <add key="SmartSpectra-RC" value="https://packages.presagetech.com/nuget-rc/index.json" />
  </packageSources>
  <!--
    Source mapping: SmartSpectra packages come only from the Presage feeds and
    everything else only from nuget.org. This keeps restores deterministic on a
    cold cache (the Presage feeds return 403 for unknown package paths, which
    NuGet treats as fatal) and prevents a private feed from ever shadowing a
    public package name (dependency confusion).
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="SmartSpectra">
      <package pattern="SmartSpectra.*" />
    </packageSource>
    <packageSource key="SmartSpectra-RC">
      <package pattern="SmartSpectra.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
