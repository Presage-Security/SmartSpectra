#!/usr/bin/env sh
# Copyright (C) 2026 Presage Technologies, Inc.
# SPDX-License-Identifier: LicenseRef-Proprietary
#
# debian-app-example postinst.
#
# libsmartspectra.so is bundled at /opt/debian-app-example/lib/, which is not
# on the default loader search path. It has no DT_RUNPATH (cc_shared_library
# strips $ORIGIN linkopts at link time), so register the app's lib dir with
# ldconfig to make libsmartspectra.so discoverable at load time.
set -e

cat > /etc/ld.so.conf.d/debian-app-example.conf <<'EOF'
/opt/debian-app-example/lib
EOF

/usr/sbin/ldconfig
